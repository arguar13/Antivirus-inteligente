# Artefactos de compilacion
target/
build/
dist/
*.o
*.obj
*.pdb
*.sys

# Rust
**/*.rs.bk

# Herramientas
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
__pycache__/

# Artefactos del producto (nunca deben entrar al repositorio): los modelos de
# PRODUCCION, entrenados con datos, llegan por el canal de actualizacion firmado.
*.joblib
*.onnx
models/
# EXCEPCION: los tres modelos de REFERENCIA que los crates incrustan con
# include_bytes!. No son datos entrenados: son pesos fijados a mano que generan de
# forma determinista crates/*/tools/build_*.py, y sin ellos el codigo no compila
# en un clon limpio (lo destapo el primer runner independiente, FASE 0 del MP-15).
# La puerta `incrustados` de make ci exige que todo fichero incrustado este en git.
!crates/aegis-ml/models/
!crates/aegis-ml/models/aegis-static-v1.onnx
!crates/aegis-edgeml/models/
!crates/aegis-edgeml/models/aegis-behavior-v1.onnx
!crates/aegis-l7hunter/models/
!crates/aegis-l7hunter/models/aegis-c2-l7-v1.onnx
corpus/
reports/
*.aegisq

# Entorno local
.env
.DS_Store
drivers/linux/aegis-bpf/out/
crates/aegis-unpacker/tests/fixtures/packer_stub
crates/aegis-syscallguard/tests/fixtures/syscall_stub

# Fuzzing (FASE 35): objetivos y Cargo.toml se versionan; lo generado no.
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/
/fuzz/Cargo.lock

# Artefactos de lanzamiento generados por tools/ci/artifacts.sh (FASE 36).
/dist/

# Artefactos de compilacion del plano de control (FASE 37).
/server/target/

# CA de proxy corporativo para la imagen hermetica: son de cada organizacion.
tools/toolchain/imagen/ca/*.crt

# Artefactos de la construccion hermetica (FASE 42) y de la cruzada para la
# matriz de kernels (tools/matriz-kernels/construir-cruzado.sh).
dist-hermetico/
dist-hermetico-aarch64/
drivers/linux/aegis-bpf/out-aarch64/

# Artefactos de compilacion del transporte del enjambre (workspace aparte).
/swarm-net/target/

# Ajustes del asistente propios de CADA maquina: contienen rutas locales y
# permisos concedidos por su usuario. La configuracion compartida del proyecto
# (.claude/settings.json y los hooks) si esta versionada; esta no.
# Ademas, tools/ci-local.sh incluye los ficheros sin seguir en la huella del
# arbol, asi que un fichero que cambia solo invalidaria la reanudacion a mitad
# de una tanda.
.claude/settings.local.json
