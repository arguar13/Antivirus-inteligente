<?xml version="1.0" encoding="utf-8"?>
<!--
  Proyecto WDK del driver de auto-defensa de AegisCore (FASE 47).

  POR QUE ESTE FICHERO ESTA EN EL REPOSITORIO SI NO SE COMPILA EN EL CI
  --------------------------------------------------------------------
  El CI de este proyecto corre en Linux y no puede compilarlo. Dejarlo fuera
  significaria que quien tenga que construir el driver en Windows tenga que
  reconstruir a mano las opciones —y las opciones de un driver no son un
  detalle: `TreatWarningAsError`, el analisis estatico del WDK y el modelo de
  driver son lo que separa un driver que funciona de uno que provoca
  pantallazos azules en el equipo de un cliente.
-->
<Project DefaultTargets="Build" ToolsVersion="16.0"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{A4E91S00-0000-4000-8000-AEG1SC0RE047}</ProjectGuid>
    <TargetName>aegis</TargetName>
    <!-- KMDF y no WDM: el marco gestiona la cola de peticiones y el ciclo de
         vida, que son la fuente habitual de fugas de referencia en un driver
         escrito a mano. -->
    <DriverType>KMDF</DriverType>
    <!-- Windows 10 1809 en adelante: es la version desde la que ETW-Ti expone
         los eventos de inyeccion que este producto necesita. -->
    <TargetVersion>Windows10</TargetVersion>
    <WindowsTargetPlatformVersion>10.0.17763.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Un aviso en un driver es un fallo. En modo kernel no hay un proceso
           que se caiga: se cae la maquina del cliente, y el volcado no siempre
           dice por que. -->
      <TreatWarningAsError>true</TreatWarningAsError>
      <WarningLevel>Level4</WarningLevel>
      <!-- Las anotaciones SAL del WDK son lo que permite al analisis estatico
           detectar IRQL incorrectos y punteros sin comprobar ANTES de cargar
           nada en un kernel. -->
      <EnablePREfast>true</EnablePREfast>
      <AdditionalIncludeDirectories>$(ProjectDir)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <!-- Sin esto, `ObRegisterCallbacks` enlaza pero devuelve
           STATUS_ACCESS_DENIED en tiempo de ejecucion. -->
      <AdditionalDependencies>$(DDK_LIB_PATH)\ntoskrnl.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <DriverSign>
      <!-- El EKU de proteccion antimalware (1.3.6.1.4.1.311.61.4.1). Sin el no
           hay auto-defensa, por muy bien escrito que este el codigo. -->
      <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
    </DriverSign>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="driver.c" />
    <ClCompile Include="obcallbacks.c" />
    <!-- La DECISION. Es C portable y se ejercita en Linux con gcc y clang en
         cada `make ci`; aqui se compila el MISMO fichero, no una copia. -->
    <ClCompile Include="aegis_politica.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="include\aegis_politica.h" />
  </ItemGroup>
  <ItemGroup>
    <FilesToPackage Include="$(TargetPath)" />
    <Inf Include="aegis.inf" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
