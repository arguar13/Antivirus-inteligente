# Agente AegisCore. Generado por Ansible; no editar a mano.
#
# ENDURECIMIENTO: UN EQUILIBRIO, NO UNA LISTA DE CASILLAS
#
# La tentacion con systemd es activar todas las protecciones que existen. Aqui
# no se puede: un EDR necesita ver el sistema entero y hablar con el kernel. Si
# se le encierra del todo, deja de detectar —y un antivirus que no detecta es
# peor que ninguno, porque da confianza sin darla—.
#
# Lo que sigue concede EXACTAMENTE lo que el agente necesita y niega el resto,
# con el motivo de cada excepcion escrito al lado.

[Unit]
Description=Agente EDR AegisCore
Documentation=https://github.com/arguar13/Antivirus-inteligente
After=network-online.target
Wants=network-online.target
# El supervisor vigila al agente; si el agente muere, aquel lo levanta.
Before=aegis-watchdog.service

[Service]
Type=notify
ExecStart={{ aegis_agente_bin_dir }}/aegis-agent --config {{ aegis_agente_etc_dir }}/agente.toml
ExecReload=/bin/kill -HUP $MAINPID

# --- Identidad --------------------------------------------------------------
# NO corre como root pese a necesitar capacidades de kernel: con capacidades
# concretas obtiene lo que necesita sin poder hacer todo lo demas.
User={{ aegis_agente_usuario }}
Group={{ aegis_agente_grupo }}

# --- Capacidades: lo minimo para que un EDR funcione ------------------------
# CAP_BPF + CAP_PERFMON : cargar los programas eBPF y leer los contadores.
# CAP_SYS_PTRACE        : inspeccionar la memoria de otros procesos (deteccion
#                         de inyeccion y de vaciado de procesos).
# CAP_DAC_READ_SEARCH   : leer ficheros de cualquier usuario para analizarlos,
#                         sin poder ESCRIBIRLOS.
# CAP_NET_ADMIN + RAW   : observar y filtrar trafico.
# CAP_SYS_RESOURCE      : subir sus propios limites de memoria bloqueada (eBPF).
# CAP_KILL              : terminar un proceso malicioso, que es media respuesta.
#
# No estan CAP_SYS_ADMIN ni CAP_SYS_MODULE: un agente comprometido no debe poder
# cargar un modulo de kernel ni montar sistemas de ficheros.
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_RESOURCE CAP_KILL
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_RESOURCE CAP_KILL
NoNewPrivileges=true

# --- Sistema de ficheros ----------------------------------------------------
# `strict` deja TODO en solo lectura y luego se abren las tres rutas que el
# agente escribe. Asi, un fallo de memoria explotado en el agente no puede
# modificar un binario del sistema para persistir.
ProtectSystem=strict
ReadWritePaths={{ aegis_agente_var_dir }} {{ aegis_agente_log_dir }} {{ aegis_agente_etc_dir }}/pki
ProtectHome=read-only
PrivateTmp=true

# ProcSubset y ProtectProc quedan en los valores permisivos A PROPOSITO: el
# agente TIENE que ver /proc de los demas procesos. Es literalmente su trabajo.
ProcSubset=all
ProtectProc=default

# --- Nucleo -----------------------------------------------------------------
ProtectKernelTunables=true
ProtectKernelLogs=false
ProtectControlGroups=true
# ProtectKernelModules NO se activa: el agente lee la lista de modulos cargados
# para detectar rootkits. No puede cargarlos (no tiene CAP_SYS_MODULE), pero si
# necesita mirarlos.
ProtectKernelModules=false
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true

# MemoryDenyWriteExecute NO se activa: el desempaquetador dinamico ejecuta
# codigo en memoria en su recinto para observar como se desempaqueta el malware.
# Con esta proteccion, esa capacidad desaparece.
MemoryDenyWriteExecute=false

# --- Red --------------------------------------------------------------------
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
RestrictNamespaces=true

# --- Llamadas al sistema ----------------------------------------------------
SystemCallFilter=@system-service @network-io bpf perf_event_open ptrace process_vm_readv
SystemCallFilter=~@clock @cpu-emulation @obsolete @raw-io @reboot @swap @mount
SystemCallArchitectures=native

# --- Recursos ---------------------------------------------------------------
# El presupuesto de memoria del agente lo vigila el pipeline en cada commit;
# aqui se impone como limite duro. Si algun dia se dispara, el endpoint mata al
# agente antes de que el agente afecte a la maquina del cliente.
MemoryMax={{ aegis_agente_memoria_max }}
MemoryHigh={{ (aegis_agente_memoria_max | regex_replace('M$','') | int * 3 / 4) | round | int }}M
CPUQuota={{ aegis_agente_cpu_max }}
TasksMax=256
LimitNOFILE=65536
# eBPF necesita memoria bloqueada.
LimitMEMLOCK=infinity

# --- Supervivencia ----------------------------------------------------------
Restart=always
RestartSec=5
# Sin limite de rafaga: si el agente entra en bucle de fallo, systemd lo
# seguiria levantando. Un EDR que se rinde tras cinco intentos deja el endpoint
# desprotegido justo cuando algo lo esta tumbando a proposito.
StartLimitIntervalSec=0

# --- Registro ---------------------------------------------------------------
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aegis-agent

[Install]
WantedBy=multi-user.target
